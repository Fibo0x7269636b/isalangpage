{
  "name": "isalang",
  "displayName": "Isalang",
  "scopeName": "source.isalang",
  "aliases": [
    "isa"
  ],
  "fileTypes": [
    "isa"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#macros"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#protocol"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.isalang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.isalang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.isalang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.isalang",
          "match": "\\\\(?:[nrt0\\\\\"']|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
        },
        {
          "name": "constant.other.placeholder.isalang",
          "match": "\\{(?::\\?)?\\}"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.isalang",
      "match": "'(?:\\\\(?:[nrt0\\\\\"']|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})|[^'\\\\])'"
    },
    "macros": {
      "patterns": [
        {
          "match": "(@macro)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.macro.isalang"
            },
            "2": {
              "name": "entity.name.function.macro.isalang"
            }
          }
        },
        {
          "name": "keyword.other.import.isalang",
          "match": "@import\\b"
        },
        {
          "name": "entity.name.function.macro.isalang",
          "match": "@[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*"
        },
        {
          "name": "variable.parameter.macro.isalang",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.isalang",
          "match": "\\b0x[0-9A-Fa-f_]+(?:[iu](?:8|16|32|64|size))?\\b"
        },
        {
          "name": "constant.numeric.binary.isalang",
          "match": "\\b0b[01_]+(?:[iu](?:8|16|32|64|size))?\\b"
        },
        {
          "name": "constant.numeric.float.isalang",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?(?:f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.isalang",
          "match": "\\b[0-9][0-9_]*(?:[iu](?:8|16|32|64|size)|f32|f64)?\\b"
        }
      ]
    },
    "protocol": {
      "patterns": [
        {
          "match": "\\b(protocol)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.protocol.isalang"
            },
            "2": {
              "name": "entity.name.type.protocol.isalang"
            }
          }
        },
        {
          "match": "\\b(initial|final|state)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.state.isalang"
            },
            "2": {
              "name": "entity.name.type.state.isalang"
            }
          }
        },
        {
          "match": "(->)\\s*([A-Z][A-Za-z0-9_]*)\\s*;",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.isalang"
            },
            "2": {
              "name": "entity.name.type.state.isalang"
            }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.isalang"
            },
            "2": {
              "name": "entity.name.function.isalang"
            }
          }
        },
        {
          "match": "\\b(struct|enum|union|impl|type)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.isalang"
            },
            "2": {
              "name": "entity.name.type.isalang"
            }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Z_][A-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.const.isalang"
            },
            "2": {
              "name": "variable.other.constant.isalang"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.isalang",
          "match": "\\b(if|else|while|loop|for|in|break|continue|return|match|await)\\b"
        },
        {
          "name": "keyword.declaration.isalang",
          "match": "\\b(fn|let|const|struct|enum|union|impl|protocol|state|initial|final|type|extern|async)\\b"
        },
        {
          "name": "storage.modifier.access.shared.isalang",
          "match": "\\bshared\\b"
        },
        {
          "name": "storage.modifier.access.unique.isalang",
          "match": "\\b(unique|mut)\\b"
        },
        {
          "name": "keyword.other.borrow.isalang",
          "match": "\\b(borrow)\\b"
        },
        {
          "name": "storage.modifier.isalang",
          "match": "\\b(pub|unsafe|as)\\b"
        },
        {
          "name": "variable.language.self.isalang",
          "match": "\\bself\\b"
        },
        {
          "name": "constant.language.boolean.isalang",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.isalang",
          "match": "\\b(i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64|bool|char|str)\\b"
        },
        {
          "name": "variable.other.constant.isalang",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        },
        {
          "name": "entity.name.type.isalang",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.isalang"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.isalang",
          "match": "->|=>"
        },
        {
          "name": "punctuation.separator.path.isalang",
          "match": "::"
        },
        {
          "name": "keyword.operator.isalang",
          "match": "&&|\\|\\||<<|>>|[=!<>]=|\\+\\+|--|[-+*/%&|^!<>=]"
        },
        {
          "name": "keyword.operator.range.isalang",
          "match": "\\.\\."
        }
      ]
    }
  }
}