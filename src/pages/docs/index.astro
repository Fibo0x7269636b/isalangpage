---
import Docs from '../../layouts/Docs.astro';
import { getDocs, groupBySection, docPath } from '../../lib/docs.js';
import { url } from '../../lib/paths.js';
import { SITE } from '../../site.config.js';
const docs = await getDocs();
const sections = groupBySection(docs);
---
<Docs title="Documentação" description="Documentação técnica da Isalang e do compilador Isac.">
  <div class="docs-home">
    <h1>Documentação</h1>
    {docs.length === 0 ? (
      <div class="empty">
        <p class="lead">
          Ainda não há páginas publicadas. A estrutura está pronta: cada arquivo Markdown ou MDX em
          <code>{SITE.docsDir}/</code> vira uma página, entra na navegação, na busca e passa pela verificação
          de exemplos no CI.
        </p>
        <ol class="flow">
          <li>
            <span class="n mono">1</span>
            <div><h2>Escrever</h2><p>No <a href={url('/docs/editor/')}>editor de páginas</a>, com pré-visualização, verificação dos blocos <code>isalang</code> pelo compilador WebAssembly. Localmente: <code>npm run docs:new</code>.</p></div>
          </li>
          <li>
            <span class="n mono">2</span>
            <div><h2>Propor</h2><p>O editor abre o GitHub com o arquivo preenchido em <code>{SITE.docsDir}/</code>. Quem não tem permissão de escrita recebe um fork e um pull request; nenhum token é guardado no site.</p></div>
          </li>
          <li>
            <span class="n mono">3</span>
            <div><h2>Verificar e publicar</h2><p>O workflow roda <code>npm run docs:check</code>, que compila cada bloco <code>isalang</code> com o mesmo <code>isac.wasm</code> do Lab. Depois do merge, o GitHub Actions gera o site e publica no GitHub Pages.</p></div>
          </li>
        </ol>
        <div class="actions">
          <a class="btn primary" href={url('/docs/editor/')}>Abrir o editor</a>
        </div>
      </div>
    ) : (
      <div class="sections">
        {sections.map(s => (
          <section>
            <h2 class="label">{s.name}</h2>
            <ul>
              {s.pages.map(p => (
                <li><a href={url(docPath(p))}><span class="t">{p.data.title}</span>{p.data.description && <span class="d">{p.data.description}</span>}</a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )}
  </div>
</Docs>
<style>
  .docs-home h1 { font-size: clamp(30px, 4vw, 42px); margin: 0 0 18px; }
  .lead { color: var(--fg-muted); font-size: 17px; max-width: 66ch; }
  .flow { list-style: none; margin: 36px 0; padding: 0; display: grid; gap: 0; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; max-width: 820px; }
  .flow li { display: grid; grid-template-columns: 44px 1fr; gap: 12px; padding: 18px 20px; background: var(--bg-1); border-bottom: 1px solid var(--line); }
  .flow li:last-child { border-bottom: none; }
  .flow .n { color: var(--own); font-size: 13px; padding-top: 3px; }
  .flow h2 { font-size: 16px; margin: 0 0 6px; }
  .flow p { margin: 0; color: var(--fg-muted); font-size: 14.5px; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .sections { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 28px; margin-top: 24px; }
  .sections ul { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .sections a { display: block; padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; background: var(--bg-1); }
  .sections a:hover { border-color: var(--line-strong); }
  .sections .t { display: block; font-weight: 600; }
  .sections .d { display: block; color: var(--fg-muted); font-size: 14px; }
  @media (max-width: 560px) {
    .lead { font-size: 16px; }
    .flow { margin: 28px 0; }
    .flow li { grid-template-columns: 18px 1fr; gap: 10px; padding: 16px 14px; }
    .actions .btn { flex: 1; justify-content: center; height: 44px; }
  }
</style>
