---
import Base from '../layouts/Base.astro';
import manifest from '../../public/isac/manifest.json';
import examples from '../data/lab-examples.json';
import LabLimits from '../components/LabLimits.astro';

const mib = (n: number) => (n / 1048576).toFixed(1).replace('.', ',') + ' MiB';
const counts = examples.entries.reduce((acc: Record<string, number>, e: any) => ((acc[e.status] = (acc[e.status] ?? 0) + 1), acc), {});
---
<Base title="Lab" section="lab" footer={false} description="Escreva, compile e execute programas Isalang no navegador com o compilador Isac em WebAssembly.">
  <div class="lab" id="lab" data-view="gate">
    <!-- 1. gate: nothing heavy is fetched until the user asks -->
    <section class="gate wrap" data-view-panel="gate" aria-labelledby="gate-title">
      <div class="gate-text">
        <p class="label">Isalang Lab</p>
        <h1 id="gate-title">O compilador roda no seu navegador.</h1>
        <p class="lead">
          O Lab usa a build WebAssembly do Isac: o mesmo frontend, os mesmos verificadores e o mesmo backend MLIR/LLVM
          do compilador nativo. O objeto gerado é ligado ao runtime C da Isalang, compilado para WebAssembly, e executado
          em um worker. Também é possível ver os diagnósticos e cada representação intermediária. Nenhum código é
          enviado a um servidor.
        </p>
        <div class="actions">
          <button class="btn primary" type="button" data-start>Carregar o compilador</button>
          <span class="size mono">download de {mib(manifest.compiler.gzipBytes)} · {mib(manifest.compiler.bytes)} após descompressão</span>
        </div>
      </div>
      <dl class="facts mono">
        <div><dt>compilador</dt><dd>isac.wasm · {manifest.compiler.sha256.slice(0, 12)}</dd></div>
        <div><dt>toolchain</dt><dd>LLVM/MLIR {manifest.toolchain?.llvm} · Emscripten {manifest.toolchain?.emscripten}</dd></div>
        <div><dt>target</dt><dd>{manifest.target}</dd></div>
        <div><dt>runtime</dt><dd>isac-runtime.wasm · {Math.round(manifest.runtime.bytes / 1024)} KiB</dd></div>
        <div><dt>exemplos</dt><dd>{counts.runs ?? 0} executam · {counts.rejected ?? 0} rejeitado de propósito</dd></div>
      </dl>
      <div class="limits">
        <h2 class="label">Não funciona no laboratório</h2>
        <LabLimits />
      </div>
    </section>

    <!-- 2. boot log with real progress -->
    <section class="boot wrap" data-view-panel="loading" hidden aria-live="polite" aria-labelledby="boot-title">
      <h1 id="boot-title" class="label">Inicializando o Isac</h1>
      <ol class="steps mono">
        <li data-step="manifest"><span class="mark"></span><span class="name">manifest</span><span class="detail">isac/manifest.json</span></li>
        <li data-step="download"><span class="mark"></span><span class="name">download</span><span class="detail">isac.wasm.gz · {mib(manifest.compiler.gzipBytes)}</span>
          <div class="progress" role="progressbar" aria-label="Download do compilador" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div></li>
        <li data-step="compile"><span class="mark"></span><span class="name">compile</span><span class="detail">WebAssembly.compileStreaming · {mib(manifest.compiler.bytes)}</span></li>
        <li data-step="selftest"><span class="mark"></span><span class="name">autoteste</span><span class="detail">isac --print-target</span></li>
      </ol>
      <p class="hint">A descompressão e a compilação do módulo acontecem durante o download. O módulo fica em memória até a aba ser fechada; ao voltar ao Lab nesta sessão ele não é carregado de novo.</p>
    </section>

    <!-- 3. failure -->
    <section class="failed wrap" data-view-panel="error" hidden role="alert">
      <h1 class="label">Falha ao inicializar</h1>
      <pre class="error-text mono" data-error></pre>
      <p>O restante do site continua funcionando. Verifique a conexão e tente de novo; o navegador precisa de WebAssembly, módulos em workers e <code>DecompressionStream</code>.</p>
      <button class="btn primary" type="button" data-retry>Tentar novamente</button>
    </section>

    <!-- 4. IDE -->
    <section class="ide" data-view-panel="ready" hidden aria-label="Ambiente do Lab" data-busy="false">
      <div class="toolbar">
        <label class="example-picker">
          <span class="visually-hidden">Exemplo</span>
          <select data-example></select>
          <span class="modified mono" data-modified hidden>editado</span>
        </label>
        <div class="spacer"></div>
        <label class="opt"><span class="visually-hidden">Otimização</span>
          <select data-opt class="mono">
            <option value="-O0">-O0</option><option value="-O1">-O1</option><option value="-O2">-O2</option><option value="-O3">-O3</option><option value="-Os">-Os</option>
          </select>
        </label>
        <button class="btn small" type="button" data-check title="Ctrl+Shift+Enter">Verificar</button>
        <button class="btn small" type="button" data-stop hidden>Parar</button>
        <button class="btn small primary" type="button" data-run title="Ctrl+Enter">Executar</button>
      </div>
      <div class="example-info" data-example-info hidden></div>
      <div class="panes">
        <div class="pane editor-pane">
          <div class="tabs" data-tabs role="tablist" aria-label="Arquivos"></div>
          <div class="editor" data-editor></div>
        </div>
        <div class="pane output-pane">
          <div class="tabs panel-tabs" role="tablist" data-panel-tabs aria-label="Painéis">
            <button type="button" role="tab" data-panel-tab="terminal" aria-selected="true">Terminal</button>
            <button type="button" role="tab" data-panel-tab="problems" aria-selected="false">Problemas <span class="count" data-problem-count hidden></span></button>
            <button type="button" role="tab" data-panel-tab="ir" aria-selected="false">IR</button>
            <button type="button" role="tab" data-panel-tab="limits" aria-selected="false">Não funciona</button>
          </div>
          <div class="panel" data-panel="terminal" role="tabpanel">
            <div class="panel-tools"><span class="label">saída</span><button type="button" class="link" data-clear>limpar</button></div>
            <div class="terminal-scroll"><pre class="terminal mono" data-terminal aria-live="polite"></pre></div>
            <div class="stdin-dock" data-stdin-dock>
              <div class="dock-head">
                <label for="lab-stdin" class="dock-title">Entrada do programa <span class="mono">(stdin)</span></label>
                <span class="dock-flag mono" data-reads-input hidden>este programa lê a entrada com @input</span>
              </div>
              <textarea id="lab-stdin" class="mono" data-stdin rows="3" spellcheck="false" placeholder="Digite aqui o que o programa vai ler, uma linha por pedido de @input. Preencha antes de clicar em Executar."></textarea>
              <div class="dock-args">
                <label for="lab-args" class="mono">argumentos</label>
                <input id="lab-args" class="mono" data-args type="text" spellcheck="false" placeholder="separados por espaço (argv[0] é program)" />
              </div>
            </div>
          </div>
          <div class="panel" data-panel="problems" role="tabpanel" hidden><div class="problems" data-problems></div></div>
          <div class="panel ir-panel" data-panel="ir" role="tabpanel" hidden>
            <div class="stages" data-stages role="group" aria-label="Estágio do pipeline"></div>
            <div class="panel-tools">
              <code class="cmd" data-ir-cmd></code>
              <label><span class="visually-hidden">Target</span>
                <select data-target class="mono"><option value="wasm32">wasm32</option><option value="x86_64">x86-64</option></select>
              </label>
              <span class="label" data-ir-size></span>
              <button type="button" class="link" data-ir-copy>copiar</button>
            </div>
            <div class="ir" data-ir></div>
          </div>
          <div class="panel limits-panel" data-panel="limits" role="tabpanel" hidden>
            <p class="hint">Recursos que não funcionam no laboratório. FFI com ponte C, threads e sanitizers precisam do compilador nativo.</p>
            <LabLimits />
          </div>
        </div>
      </div>
      <div class="statusbar mono">
        <span data-target-info>isac</span>
        <span class="status" data-status></span>
      </div>
    </section>
  </div>
</Base>

<script>
  import { labStatus, startLab } from '../lab/client.js';

  let unsubscribe: (() => void) | null = null;
  let ideModule: any = null;

  const mib = (n: number) => (n / 1048576).toFixed(1).replace('.', ',');

  function render(lab: HTMLElement, s: any) {
    const view = s.state === 'idle' ? 'gate' : s.state;
    if (lab.dataset.view !== view) {
      lab.dataset.view = view;
      document.body.dataset.labView = view;
      lab.querySelectorAll<HTMLElement>('[data-view-panel]').forEach(p => { p.hidden = p.dataset.viewPanel !== view; });
    }
    if (view === 'loading' || view === 'ready') {
      for (const [name, step] of Object.entries<any>(s.steps)) {
        const li = lab.querySelector<HTMLElement>(`[data-step="${name}"]`);
        if (!li) continue;
        li.dataset.state = step.state;
        const detail = li.querySelector('.detail')!;
        if (name === 'download' && step.total) {
          const pct = Math.min(100, Math.floor((step.loaded / step.total) * 100));
          detail.textContent = `isac.wasm.gz · ${mib(step.loaded)} / ${mib(step.total)} MiB · ${pct}%`;
          const bar = li.querySelector<HTMLElement>('.progress')!;
          bar.setAttribute('aria-valuenow', String(pct));
          bar.style.setProperty('--p', pct + '%');
        }
        if (name === 'compile' && step.state === 'done' && step.ms != null) detail.textContent += ` · ${step.ms} ms após o último byte`;
        if (name === 'selftest' && step.target) detail.textContent = `isac --print-target → ${step.target}`;
      }
    }
    if (view === 'error') lab.querySelector('[data-error]')!.textContent = s.error ?? 'erro desconhecido';
    if (view === 'ready') mount(lab);
  }

  async function mount(lab: HTMLElement) {
    if (lab.dataset.mounted) return;
    lab.dataset.mounted = 'true';
    ideModule ??= await import('../lab/ui/ide.js');
    if (!document.contains(lab)) return;
    ideModule.mountIDE(lab.querySelector('.ide'));
  }

  document.addEventListener('astro:page-load', () => {
    const lab = document.getElementById('lab');
    if (!lab) return;
    lab.querySelector('[data-start]')!.addEventListener('click', () => startLab().catch(() => {}));
    lab.querySelector('[data-retry]')!.addEventListener('click', () => startLab().catch(() => {}));
    unsubscribe = labStatus.subscribe(s => render(lab, s));
    if (new URLSearchParams(location.search).has('start') && labStatus.get().state === 'idle') startLab().catch(() => {});
  });
  document.addEventListener('astro:before-swap', () => {
    if (!document.getElementById('lab')) return;
    delete document.body.dataset.labView;
    unsubscribe?.(); unsubscribe = null;
    ideModule?.unmountIDE();
  });
</script>

<style>
  .lab { min-height: calc(100vh - var(--header-h)); display: flex; flex-direction: column; }
  .lab[data-view='ready'] { height: calc(100vh - var(--header-h)); height: calc(100dvh - var(--header-h)); }

  /* gate */
  .gate { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 40px 64px; padding-top: 72px; padding-bottom: 72px; align-content: start; }
  .gate h1 { font-size: clamp(30px, 4.4vw, 50px); margin: 12px 0 18px; }
  .lead { color: var(--fg-muted); font-size: 17px; max-width: 60ch; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; margin-top: 28px; }
  .size { font-size: 12.5px; color: var(--fg-dim); }
  .facts { margin: 0; font-size: 12.5px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-1); align-self: start; }
  .facts div { display: grid; grid-template-columns: 96px 1fr; gap: 12px; padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .facts div:last-child { border-bottom: none; }
  .facts dt { color: var(--fg-dim); }
  .facts dd { margin: 0; color: var(--fg-muted); overflow-wrap: anywhere; }
  .limits { grid-column: 1 / -1; border-top: 1px solid var(--line); padding-top: 24px; }
  .limits :global(.lab-limits) { margin-top: 12px; }

  /* boot */
  .boot, .failed { padding-top: 72px; padding-bottom: 72px; max-width: 780px; }
  .steps { list-style: none; margin: 20px 0; padding: 0; font-size: 13.5px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-1); }
  .steps li { display: grid; grid-template-columns: 22px 92px 1fr; align-items: center; gap: 8px; padding: 12px 16px; border-bottom: 1px solid var(--line); color: var(--fg-dim); }
  .steps li:last-child { border-bottom: none; }
  .steps .mark::before { content: '·'; }
  .steps li[data-state='active'] { color: var(--fg); }
  .steps li[data-state='active'] .mark::before { content: '›'; color: var(--own); animation: blink 0.8s steps(2) infinite; }
  .steps li[data-state='done'] { color: var(--fg-muted); }
  .steps li[data-state='done'] .mark::before { content: '✓'; color: var(--ok); }
  .steps .detail { overflow-wrap: anywhere; }
  .progress { grid-column: 2 / -1; height: 3px; background: var(--bg-3); border-radius: 2px; overflow: hidden; }
  .progress span { display: block; height: 100%; width: var(--p, 0%); background: var(--own); transition: width .15s linear; }
  .hint { color: var(--fg-dim); font-size: 13.5px; }
  @keyframes blink { 50% { opacity: 0; } }
  .error-text { white-space: pre-wrap; color: var(--err); background: var(--bg-1); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px; margin: 16px 0; }

  /* IDE */
  .ide { flex: 1; display: flex; flex-direction: column; min-height: 0; }
  .toolbar { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-bottom: 1px solid var(--line); background: var(--bg-1); flex-wrap: wrap; }
  .spacer { flex: 1; }
  select { background: var(--bg); color: var(--fg); border: 1px solid var(--line-strong); border-radius: var(--radius); font-size: 13px; }
  select { height: 30px; padding: 0 8px; max-width: 100%; }
  .example-picker { display: flex; align-items: center; gap: 8px; min-width: 0; flex: 0 1 380px; }
  .example-picker select { flex: 1; min-width: 0; font-family: var(--font-sans); }
  .modified { font-size: 11px; color: var(--own); }
  .example-info { display: flex; flex-wrap: wrap; gap: 4px 16px; padding: 6px 12px; font-size: 13px; color: var(--fg-muted); border-bottom: 1px solid var(--line); background: var(--bg); }
  .example-info :global(.path) { color: var(--fg-dim); font-size: 12px; }
  .example-info :global(.note) { color: var(--warn); }
  .panes { flex: 1; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); min-height: 0; }
  .pane { display: flex; flex-direction: column; min-height: 0; min-width: 0; }
  .editor-pane { border-right: 1px solid var(--line); }
  .editor { flex: 1; min-height: 0; overflow: hidden; }
  .editor :global(.cm-editor) { height: 100%; }
  .tabs { display: flex; align-items: stretch; gap: 0; border-bottom: 1px solid var(--line); background: var(--bg); overflow-x: auto; min-height: 34px; flex-shrink: 0; }
  .tabs :global(.tab) { display: flex; align-items: center; border-right: 1px solid var(--line); }
  .tabs :global(button), .panel-tabs button { background: none; border: none; color: var(--fg-dim); font: 500 12.5px/1 var(--font-mono); padding: 0 12px; height: 34px; cursor: pointer; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; }
  .tabs :global(.tab.active), .panel-tabs button[aria-selected='true'] { color: var(--fg); background: var(--bg-1); box-shadow: inset 0 -2px 0 var(--own); }
  .tabs :global(.tab button:hover), .panel-tabs button:hover { color: var(--fg); }
  .tabs :global(.close) { padding: 0 8px 0 0 !important; font-size: 15px !important; }
  .tabs :global(.add) { font-size: 16px !important; }
  .tabs :global(.entry) { color: var(--own); font-size: 10px; }
  .count { background: var(--err); color: #1a0b0b; border-radius: 8px; padding: 1px 6px; font-size: 11px; }
  .panel { flex: 1; min-height: 0; display: flex; flex-direction: column; background: var(--bg-1); }
  .panel[hidden] { display: none; }
  .panel-tools { display: flex; align-items: center; gap: 10px; padding: 6px 12px; border-bottom: 1px solid var(--line); min-height: 36px; flex-wrap: wrap; }
  .panel-tools .cmd { flex: 1; font-size: 11.5px; color: var(--fg-dim); background: none; border: none; overflow-wrap: anywhere; }
  .link { background: none; border: none; color: var(--fg-dim); font: 12px var(--font-mono); cursor: pointer; padding: 2px 4px; text-decoration: underline; text-underline-offset: 3px; }
  .link:hover { color: var(--fg); }
  .panel-tools > .label:first-child { margin-right: auto; }
  .terminal-scroll { flex: 1; overflow: auto; min-height: 0; }
  .terminal { margin: 0; padding: 12px 14px; white-space: pre-wrap; word-break: break-word; font-size: 13px; line-height: 1.55; color: var(--fg); }
  .terminal :global(span) { animation: term-in .18s var(--ease) both; }
  @keyframes term-in { from { opacity: 0; } }
  .terminal :global(.cmd) { color: var(--fg-dim); }
  .terminal :global(.err) { color: #ff9a8a; }
  .terminal :global(.ok) { color: var(--ok); }
  .terminal :global(.meta) { color: var(--fg-dim); }
  .problems { overflow: auto; padding: 8px; display: flex; flex-direction: column; gap: 6px; }
  .problems :global(.empty) { color: var(--fg-dim); padding: 8px; margin: 0; font-size: 13.5px; }
  .problems :global(.problem) { display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; text-align: left; background: var(--bg); border: 1px solid var(--line); border-left: 3px solid var(--err); border-radius: 4px; padding: 10px 12px; color: var(--fg); cursor: pointer; font: inherit; font-size: 13.5px; }
  .problems :global(.problem:hover) { border-color: var(--line-strong); border-left-color: var(--err); }
  .problems :global(.sev) { color: var(--err); font-size: 12px; padding-top: 1px; }
  .problems :global(.loc) { grid-column: 2; color: var(--fg-dim); font-size: 12px; }
  .problems :global(.notes) { grid-column: 2; color: var(--fg-muted); font-size: 12.5px; white-space: pre-wrap; }
  .stages { display: flex; flex-wrap: wrap; gap: 4px; padding: 8px 12px; border-bottom: 1px solid var(--line); }
  .stages :global(.chip) { background: var(--bg); border: 1px solid var(--line); color: var(--fg-muted); border-radius: 4px; padding: 4px 8px; font-size: 11.5px; cursor: pointer; }
  .stages :global(.chip) { transition: color .15s var(--ease), border-color .15s var(--ease), background-color .15s var(--ease); }
  .stages :global(.chip:hover) { color: var(--fg); border-color: var(--line-strong); }
  .stages :global(.chip[aria-pressed='true']) { border-color: var(--own); color: var(--own); }
  .ir { flex: 1; min-height: 0; overflow: hidden; }
  .ir :global(.cm-editor) { height: 100%; }
  .limits-panel { padding: 12px 16px; overflow: auto; }
  .limits-panel :global(.lab-limits) { grid-template-columns: minmax(0, 1fr); }
  .stdin-dock { flex-shrink: 0; display: flex; flex-direction: column; gap: 8px; padding: 10px 12px 12px; border-top: 1px solid var(--line-strong); background: var(--bg-2); }
  .stdin-dock[data-active='true'] { box-shadow: inset 3px 0 0 var(--own); background: color-mix(in srgb, var(--own) 7%, var(--bg-2)); }
  .dock-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .dock-title { font-size: 13.5px; font-weight: 600; color: var(--fg); }
  .dock-title span { font-weight: 400; color: var(--fg-dim); font-size: 12px; }
  .dock-flag { font-size: 11.5px; color: var(--own); }
  .stdin-dock textarea, .stdin-dock input { width: 100%; padding: 8px 10px; background: var(--bg); color: var(--fg); border: 1px solid var(--line-strong); border-radius: var(--radius); font-size: 13px; }
  .stdin-dock textarea { resize: vertical; min-height: 64px; line-height: 1.5; }
  .stdin-dock textarea:focus, .stdin-dock input:focus { border-color: var(--own); outline: none; }
  .stdin-dock[data-active='true'] textarea { border-color: color-mix(in srgb, var(--own) 60%, var(--line-strong)); }
  .dock-args { display: flex; align-items: center; gap: 10px; }
  .dock-args label { font-size: 11.5px; color: var(--fg-dim); white-space: nowrap; }
  .dock-args input { height: 30px; }
  .terminal :global(.warn) { color: var(--warn); }
  .example-info :global(.note.unsupported) { color: var(--warn); font-weight: 500; }
  .statusbar { display: flex; gap: 16px; align-items: center; padding: 0 12px; height: 26px; font-size: 11.5px; color: var(--fg-dim); border-top: 1px solid var(--line); background: var(--bg); overflow: hidden; white-space: nowrap; }
  .status { display: flex; gap: 14px; overflow: hidden; }
  .status :global(.ok) { color: var(--ok); }
  .status :global(.err) { color: var(--err); }
  .status :global(.warn) { color: var(--warn); }
  .ide[data-busy='true'] .statusbar { background-image: linear-gradient(90deg, transparent, color-mix(in srgb, var(--own) 18%, transparent), transparent); background-size: 40% 100%; background-repeat: no-repeat; animation: scan 1.1s linear infinite; }
  @keyframes scan { from { background-position: -40% 0; } to { background-position: 140% 0; } }

  @media (max-width: 900px) {
    .gate { grid-template-columns: minmax(0, 1fr); padding-top: 40px; }
    .lab[data-view='ready'] { height: auto; }
    .panes { grid-template-columns: minmax(0, 1fr); }
    .editor-pane { border-right: none; border-bottom: 1px solid var(--line); }
    .editor { height: 52vh; flex: none; }
    .output-pane { min-height: 46vh; }
    .example-picker { flex-basis: 100%; }
    .toolbar .spacer { display: none; }
    .statusbar { height: auto; min-height: 26px; padding: 4px 12px; flex-wrap: wrap; white-space: normal; gap: 4px 14px; }
    .status { flex-wrap: wrap; gap: 4px 14px; }
    /* The page scrolls on phones: keep the actions reachable while reading code. */
    .toolbar { position: sticky; top: var(--header-h); z-index: 5; }
    .output-pane { scroll-margin-top: calc(var(--header-h) + 104px); }
  }
  @media (max-width: 560px) {
    .gate, .boot, .failed { padding-top: 32px; padding-bottom: 48px; }
    .actions .btn { flex: 1 1 100%; justify-content: center; height: 44px; }
    .facts div { grid-template-columns: 84px 1fr; padding: 10px 12px; }
    .steps li { grid-template-columns: 18px 76px 1fr; padding: 12px; }
    .toolbar { padding: 8px; gap: 6px; }
    .toolbar .btn { flex: 1; justify-content: center; }
    .editor { height: 46vh; height: 46svh; }
    .output-pane { min-height: 0; }
    .terminal-scroll { min-height: 28vh; max-height: 50vh; }
    .panel[data-panel='problems'], .panel[data-panel='limits'] { min-height: 28vh; }
