---
// State diagram generated from a protocol declaration at build time.
// States are laid out in declaration order; forward transitions arc above,
// backward ones below. Operations that keep the state are listed in the box
// with the receiver mode (shared/unique).
import { parseProtocols } from '../lib/protocol.js';
interface Props { source: string; name?: string }
const { source, name } = Astro.props;
const protocols = parseProtocols(source);
const p = protocols.find(x => !name || x.name === name);
if (!p) throw new Error(`protocol ${name} not found`);

const W = 220, H = 112, GAP = 110, PAD = 24;
const index = new Map(p.states.map((s, i) => [s.name, i]));
const x = (i: number) => PAD + i * (W + GAP);
const width = PAD * 2 + p.states.length * W + (p.states.length - 1) * GAP;
const transitions = p.states.flatMap(s => s.ops.filter(o => o.to !== s.name).map(o => ({ from: s.name, to: o.to, name: o.name })));
// group parallel edges (same from/to) under one arc
const edges = new Map<string, { from: string; to: string; names: string[] }>();
for (const t of transitions) {
  const key = `${t.from}->${t.to}`;
  if (!edges.has(key)) edges.set(key, { from: t.from, to: t.to, names: [] });
  edges.get(key)!.names.push(t.name);
}
const list = [...edges.values()];
const span = (e: { from: string; to: string }) => Math.abs(index.get(e.to)! - index.get(e.from)!);
const maxUp = Math.max(1, ...list.filter(e => index.get(e.to)! > index.get(e.from)!).map(span));
const maxDown = Math.max(1, ...list.filter(e => index.get(e.to)! < index.get(e.from)!).map(span));
const top = 34 + maxUp * 30, bottom = 34 + maxDown * 30;
const boxY = top;
const height = top + H + bottom;
const arcs = list.map(e => {
  const a = index.get(e.from)!, b = index.get(e.to)!;
  const forward = b > a;
  const s = span(e);
  const x1 = x(a) + W / 2 + (forward ? 18 : -18), x2 = x(b) + W / 2 + (forward ? -18 : 18);
  const y = forward ? boxY : boxY + H;
  const lift = 22 + s * 28;
  const cy = forward ? y - lift : y + lift;
  return { d: `M ${x1} ${y} C ${x1} ${cy}, ${x2} ${cy}, ${x2} ${y}`, lx: (x1 + x2) / 2, ly: forward ? cy + 6 : cy - 2, label: e.names.join(' · '), forward, x2, y };
});
const accessClass: Record<string, string> = { shared: 'shared', unique: 'unique', own: 'own' };
---
<figure class="protocol">
  <div class="scroller"><svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`proto-${p.name}`}>
    <title id={`proto-${p.name}`}>Protocolo {p.name}: estados {p.states.map(s => s.name).join(', ')}; inicial {p.initial}; final {p.finals.join(', ')}</title>
    <defs>
      <marker id="arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L8 4 L0 8 z" fill="var(--fg-dim)" />
      </marker>
    </defs>
    {arcs.map(a => (
      <g class="edge">
        <path d={a.d} fill="none" stroke="var(--fg-dim)" stroke-width="1.2" marker-end="url(#arrow)" />
        <text x={a.lx} y={a.ly} text-anchor="middle" class="edge-label">{a.label}</text>
      </g>
    ))}
    {p.states.map((s, i) => {
      const self = s.ops.filter(o => o.to === s.name);
      const isFinal = p.finals.includes(s.name);
      return (
        <g class="state">
          <rect x={x(i)} y={boxY} width={W} height={H} rx="6" fill="var(--bg-2)" stroke={s.name === p.initial ? 'var(--own)' : 'var(--line-strong)'} stroke-width={s.name === p.initial ? 1.5 : 1} />
          {isFinal && <rect x={x(i) + 4} y={boxY + 4} width={W - 8} height={H - 8} rx="4" fill="none" stroke="var(--line-strong)" stroke-dasharray="3 3" />}
          <text x={x(i) + 16} y={boxY + 28} class="state-name">{s.name}</text>
          <text x={x(i) + 16} y={boxY + 46} class="state-tag">{[s.name === p.initial && 'initial', isFinal && 'final'].filter(Boolean).join(' · ')}</text>
          {self.map((o, j) => (
            <text x={x(i) + 16} y={boxY + (s.name === p.initial || isFinal ? 70 : 56) + j * 19} class={`op ${accessClass[o.access]}`}>{o.name}<tspan class="acc">({o.access} self)</tspan></text>
          ))}
        </g>
      );
    })}
  </svg></div>
  <figcaption class="mono">Diagrama gerado do código-fonte de <code>{p.name}</code> durante o build do site.</figcaption>
</figure>

<style>
  .protocol { margin: 0; padding: 20px 24px 16px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg-1); }
  svg { max-width: 1000px; margin: 0 auto; }
  svg { width: 100%; height: auto; display: block; font-family: var(--font-mono); }
  .state-name { fill: var(--fg); font-size: 15px; font-weight: 600; }
  .state-tag { fill: var(--fg-dim); font-size: 10.5px; }
  .op { font-size: 13px; fill: var(--fg-muted); }
  .op .acc { fill: var(--fg-dim); }
  .op.shared .acc { fill: var(--shared); }
  .op.unique .acc { fill: var(--unique); }
  .edge-label { fill: var(--fg-muted); font-size: 12.5px; paint-order: stroke; stroke: var(--bg-1); stroke-width: 6px; }
  figcaption { font-size: 11.5px; color: var(--fg-dim); margin-top: 10px; }
  figcaption code { font-size: 11px; }
  @media (max-width: 720px) {
    .protocol { padding: 14px 0 12px; }
    .scroller { overflow-x: auto; padding: 0 14px; scroll-padding: 14px; -webkit-overflow-scrolling: touch; }
    svg { width: 680px; max-width: none; }
    figcaption { padding: 0 14px; }
  }
</style>
