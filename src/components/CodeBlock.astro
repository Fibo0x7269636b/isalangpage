---
import { Code } from 'astro:components';
import isalang from '../lib/isalang.tmLanguage.json';
import theme from '../lib/shiki-theme.json';
import { url } from '../lib/paths.js';
interface Props { code: string; lang?: string; file?: string; example?: string; class?: string }
const { code, lang = 'isalang', file, example, class: cls } = Astro.props;
const language: any = lang === 'isalang' ? isalang : lang;
---
<div class:list={['codeblock', cls]}>
  {(file || example) && (
    <div class="cb-head">
      {file && <span class="cb-file mono">{file}</span>}
      {example && <a class="cb-lab mono" href={url(`/lab/?example=${encodeURIComponent(example)}&start`)} data-lab-start>abrir no Lab →</a>}
    </div>
  )}
  <Code code={code.replace(/\n$/, '')} lang={language} theme={theme as any} />
</div>
<style>
  .codeblock { border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-1); overflow: hidden; min-width: 0; }
  .codeblock :global(pre.astro-code) { border: none; border-radius: 0; margin: 0; }
  .cb-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 14px; border-bottom: 1px solid var(--line); background: var(--bg); }
  .cb-file { font-size: 12px; color: var(--fg-dim); }
  .cb-lab { font-size: 12px; color: var(--own); text-decoration: none; }
  .cb-lab:hover { text-decoration: underline; }
</style>
