{
  "name": "isalang-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-subdir _pagefind",
    "preview": "astro preview",
    "sync:compiler": "node scripts/sync-compiler.mjs",
    "build:runtime": "bash tools/runtime/build.sh",
    "lab:examples": "node scripts/lab-examples.mjs",
    "docs:new": "node scripts/docs-new.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "astro": "^7.4.12",
    "marked": "^18.2.0",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "pagefind": "^1.6.0"
  }
}
