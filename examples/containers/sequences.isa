// Arrays, slices e String emprestados a funções Isalang.
fn sum(values: &i32[]) -> i32 {
  let total = 0;
  for i in 0usize..values.len() {
    total = total + values[i];
  }
  return total;
}
fn update(values: &mut u8[]) {
  for i in 0usize..values.len() {
    values[i] = values[i] * 2u8;
  }
}
fn text_length(text: &String) -> usize {
  return text.len();
}
fn main() {
  let values: i32[3] = [10, 20, 12];
  let bytes: u8[3] = [1u8, 2u8, 3u8];
  let text = String::from("Olá");
  @println("sum={} bytes={}", sum(&values), text_length(&text));
  update(&mut bytes);
  @println("{} {} {}", bytes[0], bytes[1], bytes[2]);
}
